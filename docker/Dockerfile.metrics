FROM python:3.13-slim

ARG APP_UID=1000
ARG APP_GID=1000

RUN if ! getent group "${APP_GID}" >/dev/null; then addgroup --gid "${APP_GID}" appgroup; fi \
    && adduser --uid "${APP_UID}" --gid "${APP_GID}" --system --home /app appuser \
    && apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /app
ENV UV_PROJECT_ENVIRONMENT=/opt/venv
ENV UV_CACHE_DIR=/tmp/uv
ENV HOME=/app

COPY app/pyproject.toml app/uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project \
    && rm -rf /tmp/uv

COPY --chown=${APP_UID}:${APP_GID} app/ .

USER appuser
EXPOSE 9100

CMD ["uv", "run", "--no-sync", "uvicorn", "metrics_exporter:app", "--host", "0.0.0.0", "--port", "9100", "--loop", "uvloop", "--workers", "1"]
