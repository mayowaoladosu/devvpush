{
  "scripts": {
    "build": "npm run css && npm run email && npm run alpine && npm run htmx && npm run htmx-sse && npm run basecoat",
    "css:dev": "tailwindcss -i ./src/styles.css -o ./assets/styles.css --watch",
    "css": "tailwindcss -i ./src/styles.css -o ./assets/styles.css --minify",
    "email": "mjml src/login.mjml -o ./templates/email/login.html && mjml src/email-change.mjml -o ./templates/email/email-change.html && mjml src/team-invite.mjml -o ./templates/email/team-invite.html",
    "alpine": "node -e \"require('fs').copyFileSync('node_modules/alpinejs/dist/cdn.min.js','assets/alpine.min.js')\"",
    "htmx": "node -e \"require('fs').copyFileSync('node_modules/htmx.org/dist/htmx.min.js','assets/htmx.min.js')\"",
    "htmx-sse": "node -e \"require('fs').copyFileSync('node_modules/htmx-ext-sse/dist/sse.min.js','assets/htmx-sse.min.js')\"",
    "basecoat": "node -e \"require('fs').copyFileSync('node_modules/basecoat-css/dist/js/all.min.js','assets/basecoat.min.js')\""
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.18",
    "alpinejs": "^3.15.3",
    "basecoat-css": "^0.3.11",
    "htmx-ext-sse": "^2.2.4",
    "htmx.org": "^2.0.8",
    "mjml": "5.4.0",
    "tailwindcss": "^4.1.18"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "editorconfig": "3.0.2",
    "glob": "13.0.6",
    "js-beautify": "2.0.3",
    "minimatch": "10.2.6"
  }
}
