# Local development configuration
# Copy to ./data/.env and fill in your values

# Secrets
SECRET_KEY=
ENCRYPTION_KEY= # python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
POSTGRES_PASSWORD=pgsql_password

# Domains & SSL
APP_HOSTNAME=localhost
DEPLOY_DOMAIN=localhost
SERVER_IP=127.0.0.1
LE_EMAIL=dev@example.com

# GitHub App (see https://devpu.sh/gh-app)
GITHUB_APP_ID=
GITHUB_APP_NAME=
GITHUB_APP_PRIVATE_KEY= # PEM content, use \n for newlines
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# Email (only needed for email login/invites)
EMAIL_SENDER_ADDRESS=
RESEND_API_KEY= # Optional if SMTP is configured (see below)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=

# Optional
# DEVPUSH_VOLUME_PREFIX=devpush # Isolate local Docker volumes when running multiple checkouts
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APP_NAME=/dev/push
# APP_DESCRIPTION=
# EMAIL_SENDER_NAME=/dev/push
# POSTGRES_DB=devpush
# POSTGRES_USER=devpush-app
# REDIS_URL=redis://redis:6379
# DEFAULT_CPUS=0.5
# MAX_CPUS=4.0
# DEFAULT_MEMORY_MB=2048
# MAX_MEMORY_MB=8192
# DEFAULT_DB_SIZE_LIMIT_BYTES=5368709120
# JOB_TIMEOUT_SECONDS=320
# JOB_MAX_TRIES=3
# DEPLOYMENT_TIMEOUT_SECONDS=300
# DEPLOYMENT_SCHEDULE_LOCK_SECONDS=120
# DEPLOYMENT_SCHEDULE_WAIT_SECONDS=15
# DEPLOYMENT_ABORT_TIMEOUT_SECONDS=5
# DEPLOYMENT_WORKER_HEARTBEAT_SECONDS=5
# DEPLOYMENT_ORPHAN_TIMEOUT_SECONDS=20
# DEPLOYMENT_ORPHAN_CONFIRM_SECONDS=10
# DEPLOYMENT_QUEUE_GRACE_SECONDS=90
# DEPLOYMENT_RECONCILE_INTERVAL_SECONDS=5
# PROMETHEUS_QUERY_TIMEOUT_SECONDS=8
# PROMETHEUS_RETENTION_TIME=7d # Prometheus duration, e.g. 168h or 7d
# PROMETHEUS_RETENTION_SIZE=2GB # Prometheus size, e.g. 512MB or 2GB
# PROMETHEUS_MEMORY_LIMIT=384m
# PROMETHEUS_CPUS=0.75
# DOCKERFILE_BUILD_TIMEOUT_SECONDS=900
# DOCKERFILE_IMAGE_LOAD_TIMEOUT_SECONDS=300
# BUILDKIT_INTERNAL_SUBNET=10.250.0.0/24
# BUILDKIT_PROXY_IP=10.250.0.2 # Must belong to BUILDKIT_INTERNAL_SUBNET
# DOCKERFILE_BUILD_MAX_CONCURRENCY=2
# DOCKERFILE_MAX_ARCHIVE_BYTES=268435456
# DOCKERFILE_MAX_CONTEXT_BYTES=1073741824
# DOCKERFILE_MAX_CONTEXT_FILES=100000
# DOCKERFILE_MAX_IMAGE_BYTES=2147483648
# BUILDKIT_CACHE_GC_STORAGE=2048,10240,20480 # Reserved, free-space target, maximum (MB)
# RUNTIME_PIDS_LIMIT=512
# MAGIC_LINK_TTL_SECONDS=900
# AUTH_TOKEN_TTL_DAYS=30
# AUTH_TOKEN_REFRESH_THRESHOLD_DAYS=1
# AUTH_TOKEN_ISSUER=devpush-app
# AUTH_TOKEN_AUDIENCE=devpush-web
# LOG_LEVEL=WARNING
