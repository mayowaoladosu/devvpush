# LayerRail remote deployment node
# Copy to data/node-agent.env on the node host.

# Generate at least 32 random bytes and enter the same token in the control plane.
NODE_AGENT_TOKEN=
NODE_AGENT_ID=node-us-east

# DNS name or private IP reachable by the control-plane Traefik instance.
NODE_AGENT_RUNTIME_HOST=node-us-east.internal
NODE_AGENT_RUNTIME_SCHEME=http
NODE_AGENT_PORT_MIN=30000
NODE_AGENT_PORT_MAX=39999
NODE_AGENT_MAX_DEPLOYMENTS=20

# Optional HTTPS for the control interface (required by the production control
# plane unless its insecure-endpoint operator opt-in is enabled).
# Mount certificate files through NODE_AGENT_TLS_DIR and use container paths.
# NODE_AGENT_TLS_CERT_FILE=/tls/server.crt
# NODE_AGENT_TLS_KEY_FILE=/tls/server.key
# NODE_AGENT_HEALTH_URL=https://localhost:8787/v1/health

# Runtime protocol bounds.
# NODE_AGENT_ALLOWED_IMAGE_PREFIXES=ghcr.io/devpushhq/runner-
# NODE_AGENT_MAX_IMAGE_BYTES=2147483648

# Operator settings consumed by compose/node-agent.yml.
NODE_AGENT_BIND_IP=0.0.0.0
NODE_AGENT_PORT=8787
NODE_AGENT_DATA_DIR=/var/lib/layerrail-node
NODE_AGENT_TLS_DIR=./data/node-tls
NODE_AGENT_UID=1000
NODE_AGENT_GID=1000
# Must match the node host's Docker socket group. Check with:
#   getent group docker | cut -d: -f3
DOCKER_GID=999
